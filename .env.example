# replay(默认,预烘焙回放,零 key 可跑) | live(D2,接 Claude 实时生成)
COACH_MODE=replay
# 回放倍速(演示用 2x 更紧凑)
REPLAY_SPEED=2.0
# 视频根目录(文件名 <技术>_<球员>_<年份>.mp4 = 金标)
VAULT_ROOT=/home/li/football-dribbling-vault/sports/football/videos
# live 模式:OpenAI 兼容端点(本地 CPA 8317,或赛方 Claude key 的网关)
COACH_API_BASE=http://127.0.0.1:8317/v1
COACH_API_KEY=
COACH_MODEL=claude-sonnet-5
PORT=6901
