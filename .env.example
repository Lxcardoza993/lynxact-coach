# replay(默认,预烘焙回放,零 key 可跑) | live(接 Claude 实时生成)
COACH_MODE=replay
# 回放倍速(演示用 2x 更紧凑)
REPLAY_SPEED=2.0
# 视频根目录(文件名 <技术>_<球员>_<年份>.mp4 = 金标);默认 data/vault
VAULT_ROOT=./data/vault
# 技术卡知识库目录;默认 data/techniques
VAULT_TECH_DIR=./data/techniques
# live 模式:OpenAI 兼容端点(自建网关或赛方 Claude key 网关)
COACH_API_BASE=http://127.0.0.1:8317/v1
COACH_API_KEY=
COACH_MODEL=claude-sonnet-5
PORT=6901
